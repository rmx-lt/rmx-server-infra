# Never commit keys or secrets
*_ed25519
*_rsa
*_ecdsa
id_*
!id_*.pub
*.pem
# Public device CA files (wiki Device-CA): the root certificate and the CRL.
!services/mosquitto/config/device-ca/root.pem
!services/mosquitto/config/device-ca/crl.pem
# Written by Ansible on the server only (listener 8884)
services/mosquitto/config/device-listener/8884.conf
*.key
*.ppk
*.p12
*.pfx
.env
.env.*
*secret*
*password*

# Editor / OS clutter
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Docker services: secrets and runtime data stay on the server
!.env.example
services/*/data/
# OTA firmware images (served over MQTT by the app)
services/app/firmware/
services/caddy/firmware/
services/caddy/private/

# Ansible: the vault password is never stored (typed at each run);
# group_vars/all/vault.yml IS committed, but only encrypted (CI checks it)
ansible/.vault-pass*
ansible/*.retry
