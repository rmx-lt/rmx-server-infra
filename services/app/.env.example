# Copy to .env on the server (root, mode 0600) and fill in. Never commit .env.
# Generate a password: openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 32
# Letters and digits only: the DB password goes into a URL (DATABASE_URL).

# TimescaleDB user "app" (used by db and app)
APP_DB_PASSWORD=change-me

# Mosquitto login "app" (same value as in mosquitto/data/credentials.txt)
APP_MQTT_PASSWORD=change-me

# The deployed image tag. Rewritten by /usr/local/sbin/rmx-deploy-app;
# change it only through that script (sudo rmx-deploy-app sha-xxxxxxx).
APP_TAG=production
