# Global options
{
	# HTTP/1.1 and HTTP/2 only. HTTP/3 would need 443/udp, which we don't open.
	servers {
		protocols h1 h2
	}
	# Let's Encrypt only, no ZeroSSL fallback: the mower gateway trusts only ISRG
	# Root X1/X2 (rmx-mower-gateway certs/rmx-ca-bundle.pem). A certificate
	# from another CA would cut it off, including from OTA fixes.
	cert_issuer acme {
		dir https://acme-v02.api.letsencrypt.org/directory
	}
}

# Main site: placeholder page, and rmx-server-app under /app
rmx.lt {
	# rmx-server-app. The prefix is kept: the app serves /app/... itself,
	# including its own login: a session cookie (Path=/app) checked by the
	# app on the API and /app/ws (wiki page Server-App, "Login and
	# sessions"). Only /app/health, login/logout and the static page (public
	# code, no data) work without a session.
	# Caddy adds no auth of its own (basic auth broke WebSockets on
	# iPhones). While the app is down, app doesn't resolve and Caddy answers
	# 502, so nothing under /app is open.
	# Caddy passes Cookie and Origin through and sets X-Forwarded-For to the
	# real client IP (it ignores one sent by the client), which the app's
	# login rate limit uses.
	@app path /app /app/*
	handle @app {
		reverse_proxy app:8080
	}

	handle {
		root * /srv/site
		file_server
		encode zstd gzip
	}
}

# API: placeholder. The app moved to https://rmx.lt/app/ (issue 97);
# old links under /app redirect there.
api.rmx.lt {
	@app path /app /app/*
	handle @app {
		redir https://rmx.lt{uri} 308
	}

	handle {
		header Content-Type application/json
		respond `{"service":"rmx-api","status":"placeholder"}` 200
	}
}

# www -> bare domain (301, keeps the path)
www.rmx.lt {
	redir https://rmx.lt{uri} permanent
}

# MQTT broker name. Caddy only obtains and renews the TLS certificate here;
# a host timer copies it to Mosquitto (see services/mosquitto/cert-sync/).
# MQTT itself is on port 8883, served by Mosquitto, not by Caddy. No MQTT
# goes through Caddy: browsers don't speak MQTT (removed 2026-10-20).
mqtt.rmx.lt {
	respond "MQTT broker: mqtts://mqtt.rmx.lt:8883 (TLS)" 200
}
