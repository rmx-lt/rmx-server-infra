# Managed by ansible (rmx-server-infra) on the first run only; after that ansible
# updates the two password lines and never touches APP_TAG.
# Template: services/app/.env.example.
APP_DB_PASSWORD={{ vault_app_db_password }}
APP_MQTT_PASSWORD={{ vault_mosquitto_users['app'] }}
# Rewritten by /usr/local/sbin/rmx-deploy-app; change it only through that
# script (sudo rmx-deploy-app sha-xxxxxxx). A fresh server starts with the
# newest released image (`production`, moved by every rmx-server-app
# release); the next deploy or `rmx-ci restore` pins an exact sha (#51).
# Pin one at build time with -e app_tag=sha-xxxxxxx.
APP_TAG={{ app_tag | default('production') }}
