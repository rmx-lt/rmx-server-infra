# Managed by ansible (rmx-vps) on the first run only; after that ansible
# updates the two password lines and never touches PROBE_TAG.
# Template: services/probe/.env.example.
PROBE_DB_PASSWORD={{ vault_probe_db_password }}
PROBE_MQTT_PASSWORD={{ vault_mosquitto_users['probe-app'] }}
# Rewritten by /usr/local/sbin/rmx-deploy-probe; change it only through that
# script (sudo rmx-deploy-probe sha-xxxxxxx). A fresh server starts with the
# newest released image (`production`, moved by every rmx-backend-probe
# release); the next deploy or `rmx-ci restore` pins an exact sha (#51).
# Pin one at build time with -e probe_tag=sha-xxxxxxx.
PROBE_TAG={{ probe_tag | default('production') }}
